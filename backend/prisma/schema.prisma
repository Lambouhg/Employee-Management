// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 1. ENUMS - Các kiểu dữ liệu enum
// ============================================

// Loại hình làm việc
enum EmploymentType {
  FULL_TIME // Full-time: 6 ngày/tuần
  PART_TIME // Part-time: 5 ca/tuần
}

// Trạng thái lịch làm việc
enum ScheduleStatus {
  PENDING // Chờ duyệt - nhân viên vừa submit
  APPROVED // Đã duyệt - quản lý đã xác nhận
  LOCKED // Đã khóa - không thể chỉnh sửa, sẵn sàng chấm công
  REJECTED // Bị từ chối
}

// Trạng thái kế hoạch tuần của phòng ban
enum PlanStatus {
  DRAFT // Đang soạn thảo
  PUBLISHED // Đã xuất bản - NV có thể vào đăng ký
  LOCKED // Đã chốt - Không thể chỉnh sửa thêm
}

// Trạng thái yêu cầu nghỉ
enum LeaveStatus {
  PENDING // Chờ duyệt
  APPROVED // Đã chấp nhận
  REJECTED // Đã từ chối
}

// Loại nghỉ
enum LeaveType {
  SICK // Nghỉ ốm
  EMERGENCY // Bất khả kháng
  PERSONAL // Cá nhân
  OTHER // Khác
}

// Trạng thái chấm công
enum AttendanceStatus {
  PRESENT // Có mặt
  ABSENT // Vắng mặt
  LATE // Đi muộn
  EARLY_LEAVE // Về sớm
  ON_LEAVE // Nghỉ phép
}

// Thứ trong tuần
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Loại ca làm việc
enum ShiftType {
  MORNING // Ca sáng
  AFTERNOON // Ca chiều
  EVENING // Ca tối
  NIGHT // Ca đêm
}

// Trạng thái đăng ký ca làm việc
enum RegistrationStatus {
  PENDING // Chờ duyệt
  APPROVED // Đã duyệt
  REJECTED // Bị từ chối
  CANCELLED // Nhân viên hủy
}

// Roles allowed in the system. Only these three values are permitted.
enum RoleName {
  MANAGER
  DEPT_MANAGER
  STAFF
}

// ============================================
// 2. ROLE & PERMISSION - Vai trò và quyền hạn
// ============================================

model Role {
  id          String   @id @default(uuid())
  // Use the strict enum to ensure only the three allowed roles exist
  name        RoleName @unique
  displayName String // "Quản lý", "Trưởng phòng", "Nhân viên"
  description String?
  level       Int      @default(0) // Cấp độ: 3=Manager, 2=DeptManager, 1=Staff

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // "manage_all_employees", "approve_schedule"
  displayName String // "Quản lý toàn bộ nhân viên"
  resource    String // "employee", "schedule", "attendance"
  action      String // "create", "read", "update", "delete", "approve"
  description String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id String @id @default(uuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// 3. DEPARTMENT - Phòng ban / Bộ phận
// ============================================

model Department {
  id          String  @id @default(uuid())
  name        String  @unique // "Kinh doanh", "Kỹ thuật", "Nhân sự"
  code        String  @unique // "SALES", "TECH", "HR"
  description String?

  // Trưởng phòng (Department Manager)
  managerId String? @unique
  manager   User?   @relation("DepartmentManager", fields: [managerId], references: [id])

  // Trạng thái
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employees      User[]           @relation("DepartmentEmployees")
  weeklyPlans    DeptWeeklyPlan[]
  shiftTemplates ShiftTemplate[]

  @@map("departments")
}

// ============================================
// 3.5 SHIFT TEMPLATE - Định nghĩa ca làm việc
// ============================================

model ShiftTemplate {
  id String @id @default(uuid())

  // Thông tin ca
  name String // "Ca sáng hành chính", "Ca chiều", "Ca tối"
  code String // "MORNING_8_17", "AFTERNOON_13_22"

  // Phòng ban áp dụng
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Loại ca và thời gian
  shiftType  ShiftType // MORNING, AFTERNOON, EVENING, NIGHT
  startTime  DateTime  @db.Time
  endTime    DateTime  @db.Time
  totalHours Float // Tổng số giờ (VD: 9.0, 8.5)

  // Trạng thái
  isActive Boolean @default(true) // ACTIVE/INACTIVE

  // Áp dụng cho loại nhân viên nào
  allowFullTime Boolean @default(true)
  allowPartTime Boolean @default(true)

  // Mô tả
  description String?
  notes       String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shiftOpenings ShiftOpening[]

  // Constraints
  @@unique([departmentId, code])
  @@unique([departmentId, startTime, endTime]) // Không trùng giờ trong cùng phòng
  @@index([departmentId, isActive])
  @@map("shift_templates")
}

// ============================================
// 3.6 DEPT WEEKLY PLAN - Kế hoạch tuần của phòng
// ============================================

model DeptWeeklyPlan {
  id String @id @default(uuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  weekStartDate DateTime // Ngày bắt đầu tuần (Monday)
  status        PlanStatus @default(DRAFT)

  // Người tạo/quản lý kế hoạch
  createdByUserId String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shiftOpenings ShiftOpening[]

  @@unique([departmentId, weekStartDate])
  @@map("dept_weekly_plans")
}

model ShiftOpening {
  id String @id @default(uuid())

  // Thuộc plan nào
  planId String
  plan   DeptWeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Tham chiếu template (nếu dùng template)
  templateId String?
  template   ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Thông tin ca cụ thể
  date      DateTime  @db.Date
  shiftType ShiftType

  // Thời gian (có thể override từ template)
  startTime DateTime @db.Time
  endTime   DateTime @db.Time

  // === Quản lý capacity cho Full-time ===
  isFTEnabled    Boolean @default(false) // Ca này có mở cho FT không?
  ftAutoAssigned Boolean @default(true) // Tự động gán FT khi publish?

  // === Quản lý capacity cho Part-time ===
  isPTEnabled  Boolean @default(true) // Ca này có mở cho PT không?
  ptCapacity   Int     @default(0) // Số slot tối đa cho PT
  ptRegistered Int     @default(0) // Số PT đã đăng ký (tính tự động)

  // Ghi chú
  notes String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shifts            Shift[]
  shiftRegistrations ShiftRegistration[]

  @@index([planId, date])
  @@index([templateId])
  @@map("shift_openings")
}

// ============================================
// 3.7 SHIFT REGISTRATION - Đăng ký ca làm việc
// ============================================

model ShiftRegistration {
  id String @id @default(uuid())

  // Shift opening mà nhân viên đăng ký
  openingId String
  opening   ShiftOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)

  // Nhân viên đăng ký
  employeeId String
  employee   User   @relation("ShiftRegistrations", fields: [employeeId], references: [id], onDelete: Cascade)

  // Loại nhân viên (để phân biệt PT/FT khi cần)
  employmentType EmploymentType

  // Trạng thái đăng ký
  status RegistrationStatus @default(PENDING)

  // Người duyệt (Department Manager)
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedRegistrations", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Lý do từ chối (nếu có)
  rejectionReason String?

  // Ghi chú từ nhân viên
  notes String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([openingId, employeeId]) // Một nhân viên chỉ đăng ký 1 lần cho 1 opening
  @@index([openingId, status])
  @@index([employeeId, status])
  @@index([status, createdAt])
  @@map("shift_registrations")
}

// ============================================
// 4. USER - Quản lý nhân viên
// ============================================

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  fullName String
  phone    String?

  // Vai trò (Role từ bảng riêng)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Phòng ban
  departmentId String?
  department   Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id])

  // Nếu là trưởng phòng
  managedDepartment Department? @relation("DepartmentManager")

  employmentType EmploymentType @default(FULL_TIME)
  isActive       Boolean        @default(true)

  // Full-time: ngày nghỉ cố định trong tuần
  fixedDayOff DayOfWeek?

  // Quan hệ phân cấp tổ chức (Organizational Hierarchy)
  // managerId: Người quản lý trực tiếp (line manager)
  // Dùng để:
  // - Phê duyệt lịch làm việc
  // - Phê duyệt nghỉ phép
  // - Xem báo cáo của subordinates
  managerId    String?
  manager      User?   @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates User[]  @relation("ManagerSubordinates")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  schedules         WorkSchedule[] @relation("EmployeeSchedules")
  approvedSchedules WorkSchedule[] @relation("ApprovedSchedules")

  // Team membership (optional)
  // Team concept removed — no team membership fields
  shifts                Shift[]
  shiftRegistrations    ShiftRegistration[] @relation("ShiftRegistrations")
  reviewedRegistrations ShiftRegistration[] @relation("ReviewedRegistrations")
  attendances           Attendance[]
  leaveRequests         LeaveRequest[]      @relation("EmployeeLeaveRequests")
  approvedLeaves        LeaveRequest[]      @relation("ApprovedLeaveRequests")
  activityLogs          ActivityLog[]

  @@index([departmentId])
  @@index([managerId])
  @@index([roleId])
  @@map("users")
}

// ============================================
// 4. WORK SCHEDULE - Lịch làm việc theo tuần
// ============================================
// 
// 📌 QUY ĐỊNH QUAN TRỌNG:
// - Cả Full-time và Part-time đều PHẢI đăng ký lịch trước ít nhất 1 TUẦN
// - KHÔNG cho phép đăng ký lịch trong tuần đang diễn ra
// - KHÔNG có đăng ký gấp theo ngày
// - Lịch phải được duyệt (APPROVED) trước khi có hiệu lực
// - Chỉ lịch đã LOCKED mới được dùng để chấm công
//
// Ví dụ: Hôm nay là 14/01/2026 (Tuần 3)
// → Nhân viên chỉ được đăng ký cho Tuần 4 trở đi (từ 19/01/2026)
// → Không thể đăng ký cho Tuần 3 (đang diễn ra)

model WorkSchedule {
  id String @id @default(uuid())

  // Thông tin tuần làm việc
  // CHỈ LƯU weekStartDate - các trường khác tính toán ở application layer
  weekStartDate DateTime // Ngày bắt đầu tuần (Monday) - tuần ĐƯỢC ĐĂNG KÝ

  // Nhân viên
  employeeId String
  employee   User   @relation("EmployeeSchedules", fields: [employeeId], references: [id])

  // Thời điểm đăng ký (để validation quy định 1 tuần trước)
  submittedAt DateTime @default(now()) // Thời điểm nhân viên submit lịch

  // Trạng thái
  status ScheduleStatus @default(PENDING)

  // Người duyệt
  approvedById String?
  approvedBy   User?     @relation("ApprovedSchedules", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // Người khóa lịch (thường là Manager)
  lockedAt DateTime? // Thời điểm khóa lịch (chuyển sang LOCKED)

  // Ghi chú
  notes String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shifts Shift[]

  @@unique([employeeId, weekStartDate])
  @@index([weekStartDate, status]) // Tối ưu query theo tuần và trạng thái
  @@index([employeeId, status]) // Tối ưu query lịch của nhân viên
  @@map("work_schedules")
}

// ============================================
// 6. SHIFT - Ca làm việc cụ thể
// ============================================

model Shift {
  id String @id @default(uuid())

  // Liên kết lịch làm việc
  scheduleId String
  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Thông tin ca
  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id])

  // Tham chiếu opening (nếu đăng ký từ opening)
  openingId String?
  opening   ShiftOpening? @relation(fields: [openingId], references: [id], onDelete: SetNull)

  date      DateTime  @db.Date
  shiftType ShiftType

  // Thời gian ca làm việc
  startTime DateTime @db.Time
  endTime   DateTime @db.Time

  // Loại ca: FT tự động tạo = true, PT đăng ký = false
  isAutoGenerated Boolean @default(false)

  // Ghi chú
  notes String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attendance Attendance?

  @@unique([scheduleId, date, shiftType])
  @@index([date, shiftType])
  @@index([employeeId, date])
  @@index([openingId])
  @@map("shifts")
}

// ============================================
// 7. ATTENDANCE - Chấm công thực tế
// ============================================

model Attendance {
  id String @id @default(uuid())

  // Liên kết ca làm việc
  shiftId String @unique
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  // Nhân viên
  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id])

  // Thời gian chấm công thực tế
  checkInTime  DateTime?
  checkOutTime DateTime?

  // Tổng giờ làm (tính bằng phút)
  totalMinutes Int?

  // Trạng thái
  status AttendanceStatus @default(PRESENT)

  // Ghi chú
  notes String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendances")
}

// ============================================
// 8. LEAVE REQUEST - Yêu cầu nghỉ phép
// ============================================

model LeaveRequest {
  id String @id @default(uuid())

  // Nhân viên yêu cầu
  employeeId String
  employee   User   @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id])

  // Thông tin nghỉ
  leaveType LeaveType
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  reason    String

  // Trạng thái
  status LeaveStatus @default(PENDING)

  // Người duyệt
  approvedById    String?
  approvedBy      User?     @relation("ApprovedLeaveRequests", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leave_requests")
}

// ============================================
// 9. ACTIVITY LOG - Nhật ký hoạt động
// ============================================

model ActivityLog {
  id String @id @default(uuid())

  // Người thực hiện
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Thông tin hoạt động
  action   String // VD: "CREATE_SCHEDULE", "APPROVE_LEAVE", "CHECK_IN"
  entity   String // VD: "WorkSchedule", "LeaveRequest", "Attendance"
  entityId String? // ID của entity được tác động

  // Chi tiết
  description String
  metadata    Json? // Dữ liệu bổ sung dạng JSON

  // IP và User Agent
  ipAddress String?
  userAgent String?

  // Timestamp
  createdAt DateTime @default(now())

  @@map("activity_logs")
}
